# Copy to .env (local) or set as HuggingFace Space secrets.
# Every engine is optional — the app exposes whichever ones are configured.
# Users can also paste their own keys in the app (API keys panel); those stay in
# their browser and override nothing here.

# Google Gemini (free tier, no credit card): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq (free tier, no credit card): https://console.groq.com/keys
# Powers both Groq engines. If Groq retires a model, the app switches to the
# newest one of the same family automatically.
GROQ_API_KEY=
# GROQ_QWEN_MODEL=qwen/qwen3.8-27b
# GROQ_GPTOSS_MODEL=openai/gpt-oss-120b

# OpenAI (paid, low cost): https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-luna

# OpenRouter (one key, many models, several free): https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Local NLLB (CTranslate2). Defaults are fine; override for GPU:
# CT2_DEVICE=cuda
# CT2_COMPUTE_TYPE=int8

# Local Hy-MT2 (llama.cpp): `python fetch_hymt.py` + requirements-llm.txt
# HYMT_MODEL_PATH=models/hy-mt2-1.8b/Hy-MT2-1.8B-Q4_K_M.gguf
# HYMT_THREADS=0            # 0 = let llama.cpp decide

# Ollama is bundled in the Space image. For manual dev, install Ollama and pull the model.
# OLLAMA_MODEL=translategemma:4b
# OLLAMA_HOST=http://localhost:11434
# Space defaults: one request at a time, 4K context, 2 CPU threads, unload after 2 idle minutes.
# OLLAMA_CONTEXT_LENGTH=4096
# OLLAMA_TRANSLATE_THREADS=2
# OLLAMA_KEEP_ALIVE=2m

# Comma-separated allowed origins for the frontend (dev: http://localhost:3000)
# CORS_ORIGINS=*
